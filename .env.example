# VeriLens AI Environment Variables
# Copy this file to .env and set your keys:

# Optional: Google AI Studio Gemini API Key (100% Free Tier - 1,500 RPD / 15 RPM)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash
