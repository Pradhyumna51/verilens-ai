# VeriLens AI Environment Variables
# Copy this file to .env and set your keys:

# Optional: Google AI Studio Gemini API Key (100% Free Tier - 1,500 RPD / 15 RPM)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Model identifier (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional: Google Fact Check Tools API Key (100% Free - no billing required)
# Get a free key at: https://console.cloud.google.com/apis/credentials
FACT_CHECK_API_KEY=
